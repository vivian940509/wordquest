# Local development (default)
DATABASE_URL=sqlite:///database/wordquest.local.db

# Supabase production example:
# Supabase Dashboard > Project Settings > Database > Connection string
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:6543/postgres?sslmode=require

SECRET_KEY=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Taipei

# Reserved for future Supabase Auth/browser SDK use.
# The current Flask backend connects through DATABASE_URL, so do NOT expose a service_role key in frontend code.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional AI teacher. Without these, the built-in local explanation still works.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
